@misc{wenEmbeddingPerturbationMay2026a,
  title = {Embedding {{Perturbation}} May {{Better Reflect}} the {{Uncertainty}} in {{LLM Reasoning}}},
  author = {Wen, Qihao and Wang, Jiahao and Nan, Yang and He, Pengfei and Tandon, Ravi and Xu, Han},
  year = 2026,
