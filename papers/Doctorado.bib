  publisher = {{Institute of Electrical and Electronics Engineers Inc.}},
  doi = {10.1109/CSITSS64042.2024.10817070},
  abstract = {Large Language Models (LLMs) have become a cornerstone of modern natural language processing, exhibiting remarkable capabilities in diverse applications. However, these models are not flawless. This paper provides a comprehensive analysis of the loopholes inherent in LLMs, focusing on adversarial attacks, biases, hallucinations and outdatedness. One of the main problems is hallucinations, where models generate plausible but inaccurate or unreal information. Biases introduced into training data can lead to outcomes that reflect and amplify societal prejudices leading to discriminatory behavior. Adversarial attacks exploit vulnerabilities in machine learning models by introducing subtle perturbations to input data, causing the model to make incorrect predictions with high confidence. Additionally, LLMs considerably struggle when it comes to domain-specific queries as they lack specialized knowledge and have a generalized training, thus highlighting the need for domain-specific customization. By inspecting these vulnerabilities, we aim to highlight the critical areas that require attention to ensure the safe and effective deployment of LLMs.  \copyright{} 2024 IEEE.},
  isbn = {979-8-3315-0546-2},
  langid = {english},
  keywords = {Adversarial Attacks,Biases,Ethical Implications,Hallucinations,Large Language Models,natural language processing,vulnerabilities},
  file = {C:\Users\ACER\Zotero\storage\NS2QVW6L\Sanu et al. - 2024 - Limitations of Large Language Models.pdf}
}

@inproceedings{sauhandikaaExplainableAILarge2024,
